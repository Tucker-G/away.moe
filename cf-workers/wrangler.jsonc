/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-workers",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-27",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"routes": [
		{
			"pattern": "*.away.moe/*",
			"zone_name": "away.moe"
		}
	],
	"assets": {
		"directory": "../frontend/build",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "away-moe-db",
			"database_id": "e6ecca9a-ba5c-4de1-9cf0-e1dae9a412cc"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "away-moe-files"
		}
	],
	"vars": {
		"R2_PUBLIC_HOST": "uploads.away.moe"
	},
	"send_email": [{ "name": "EMAIL" }],
	"secrets": {
    	"required": ["R2_ACCOUNT_ID", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "RECEIVING_EMAIL_ADDRESS"]
  	}
}